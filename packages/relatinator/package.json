{
  "name": "relatinator",
  "description": "A small, dependency-light library for finding related content with TF-IDF or BM25. Runs in Node, browsers, and edge runtimes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/DBozhinovski/relatinator"
  },
  "keywords": [
    "relatinator",
    "related",
    "related-content",
    "tfidf",
    "bm25",
    "posts",
    "articles",
    "static"
  ],
  "version": "3.2.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "bench": "pnpm run build && node bench/bench.mjs",
    "test:portability": "pnpm run build && node scripts/check-portability.js",
    "check": "tsc --noEmit && tsc -p test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "wink-porter2-stemmer": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.10",
    "relatinator-reference": "npm:relatinator@3.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
