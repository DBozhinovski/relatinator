{
  "name": "astro-relatinator",
  "version": "3.0.0",
  "description": "Find related entries in your Astro content collections",
  "author": "Darko Bozhinovski <dbozhinovski@gmail.com>",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-integration",
    "emdash",
    "related-content",
    "tfidf",
    "bm25",
    "relatinator",
    "related",
    "words",
    "posts",
    "articles",
    "static"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DBozhinovski/relatinator"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./emdash": {
      "types": "./dist/emdash.d.ts",
      "import": "./dist/emdash.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepack": "pnpm run build",
    "pretest": "pnpm --filter \"astro-relatinator^...\" run build",
    "test": "vitest run",
    "precheck": "pnpm --filter \"astro-relatinator^...\" run build",
    "check": "tsc --noEmit && tsc -p test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "relatinator": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "astro": "7.3.8",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0",
    "emdash": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "emdash": {
      "optional": true
    }
  }
}
